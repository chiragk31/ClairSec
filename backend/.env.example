# ClairSec Backend — Environment Variables Template
# Copy this file to .env and configure real values.
# Startup will FAIL LOUDLY if any required setting is missing.

# =============================================================================
# Required Settings (No silent defaults — must be configured)
# =============================================================================
MONGODB_URL=
MONGODB_DB=clairsec
WORKSPACE_ROOT=
# =============================================================================
# LLM Provider Configuration (LLM.md §1)
# =============================================================================
LLM_PROVIDER=mock
LLM_MODEL_ID=claude-opus-5
LLM_CACHE_MODE=read_write

# LLM_API_KEY is required only when LLM_PROVIDER != "mock"
LLM_API_KEY=

# =============================================================================
# Docker Resource Limits & Isolation (Phase 3 & 3.5)
# =============================================================================
DOCKER_MEM_LIMIT=256m
DOCKER_NANO_CPUS=500000000
DOCKER_BUILD_TIMEOUT=120
DOCKER_STARTUP_TIMEOUT=30
DOCKER_LOG_MAX_BYTES=102400
DOCKER_NETWORK_NAME=clairsec-net
DOCKER_TARGET_PORT=8000
DOCKER_PIDS_LIMIT=256

# Container Hardening Flags (THREAT_MODEL C3.1, C3.2, C3.4)
# Configurable to measure impact on import failure rate before final commitment
DOCKER_READ_ONLY=true
DOCKER_NON_ROOT=true
DOCKER_BASE_IMAGE=python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534

# =============================================================================
# API Binding & Security (THREAT_MODEL C7.1–C7.4)
# =============================================================================
API_HOST=127.0.0.1
API_PORT=8000
AUTH_TOKEN_PATH=~/.clairsec/auth_token
